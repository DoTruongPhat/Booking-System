<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="SERVICE_NAME">auth-service</Property>
    </Properties>

    <Appenders>
        <Console name="JSON" target="SYSTEM_OUT">
            <JsonLayout compact="true" eventEol="true" stacktraceAsString="true"
                        properties="true" includeTimeMillis="true">
                <KeyValuePair key="service" value="${SERVICE_NAME}"/>
            </JsonLayout>
        </Console>

        <Console name="PRETTY" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="com.booking" level="INFO"/>
        <Logger name="org.springframework" level="WARN"/>
        <Logger name="org.hibernate" level="WARN"/>
        <Root level="INFO">
            <AppenderRef ref="PRETTY"/>
        </Root>
    </Loggers>

</Configuration>