<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="revenue-report"
              pageWidth="842" pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="c0000001-0001-0001-0001-000000000001">

    <!-- PARAMETERS (from Java) -->
    <parameter name="fromDate" class="java.sql.Date"/>
    <parameter name="toDate" class="java.sql.Date"/>
    <parameter name="reportTitle" class="java.lang.String">
        <defaultValueExpression><![CDATA["REVENUE REPORT"]]></defaultValueExpression>
    </parameter>

    <!-- SQL QUERY — Jasper queries PostgreSQL directly -->
    <queryString>
        <![CDATA[
            SELECT
                h.name AS hotel_name,
                h.city AS hotel_city,
                COUNT(b.id) AS total_bookings,
                SUM(CASE WHEN b.status = 'CANCELLED' THEN 1 ELSE 0 END) AS cancelled_count,
                SUM(CASE WHEN b.status IN ('CONFIRMED', 'COMPLETED') THEN b.total_price ELSE 0 END) AS total_revenue,
                AVG(CASE WHEN b.status IN ('CONFIRMED', 'COMPLETED') THEN b.total_price ELSE NULL END) AS avg_booking_value,
                SUM(b.num_nights) AS total_nights,
                SUM(b.num_rooms) AS total_rooms_booked
            FROM booking.bookings b
            JOIN booking.hotels h ON b.hotel_id = h.id
            WHERE b.created_at >= CAST($P{fromDate} AS timestamp)
              AND b.created_at <= CAST($P{toDate} AS timestamp) + INTERVAL '1 day'
            GROUP BY h.name, h.city
            ORDER BY total_revenue DESC
        ]]>
    </queryString>

    <!-- FIELDS (map from SQL result) -->
    <field name="hotel_name" class="java.lang.String"/>
    <field name="hotel_city" class="java.lang.String"/>
    <field name="total_bookings" class="java.lang.Long"/>
    <field name="cancelled_count" class="java.lang.Long"/>
    <field name="total_revenue" class="java.math.BigDecimal"/>
    <field name="avg_booking_value" class="java.math.BigDecimal"/>
    <field name="total_nights" class="java.lang.Long"/>
    <field name="total_rooms_booked" class="java.lang.Long"/>

    <!-- VARIABLES (summary) -->
    <variable name="grandTotalRevenue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total_revenue}]]></variableExpression>
    </variable>
    <variable name="grandTotalBookings" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{total_bookings}]]></variableExpression>
    </variable>

    <!-- TITLE -->
    <title>
        <band height="70">
            <textField>
                <reportElement x="0" y="0" width="802" height="30" uuid="c0000001-0001-0001-0001-000000000002"/>
                <textElement textAlignment="Center">
                    <font size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="35" width="802" height="20" forecolor="#666666" uuid="c0000001-0001-0001-0001-000000000003"/>
                <textElement textAlignment="Center">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fromDate})
                    + " - " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{toDate})]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="60" width="802" height="1" forecolor="#2196F3" uuid="c0000001-0001-0001-0001-000000000004"/>
                <graphicElement><pen lineWidth="2.0"/></graphicElement>
            </line>
        </band>
    </title>

    <!-- COLUMN HEADER -->
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="0" width="160" height="25" backcolor="#2196F3" mode="Opaque" forecolor="#FFFFFF" uuid="c0000001-0001-0001-0001-000000000010"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[  Hotel]]></text>
            </staticText>
            <staticText>
                <reportElement x="160" y="0" width="90" height="25" backcolor="#2196F3" mode="Opaque" forecolor="#FFFFFF" uuid="c0000001-0001-0001-0001-000000000011"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[  City]]></text>
            </staticText>
            <staticText>
                <reportElement x="250" y="0" width="80" height="25" backcolor="#2196F3" mode="Opaque" forecolor="#FFFFFF" uuid="c0000001-0001-0001-0001-000000000012"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Bookings]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="0" width="80" height="25" backcolor="#2196F3" mode="Opaque" forecolor="#FFFFFF" uuid="c0000001-0001-0001-0001-000000000013"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Cancelled]]></text>
            </staticText>
            <staticText>
                <reportElement x="410" y="0" width="100" height="25" backcolor="#2196F3" mode="Opaque" forecolor="#FFFFFF" uuid="c0000001-0001-0001-0001-000000000014"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Total Nights]]></text>
            </staticText>
            <staticText>
                <reportElement x="510" y="0" width="100" height="25" backcolor="#2196F3" mode="Opaque" forecolor="#FFFFFF" uuid="c0000001-0001-0001-0001-000000000015"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Rooms Booked]]></text>
            </staticText>
            <staticText>
                <reportElement x="610" y="0" width="96" height="25" backcolor="#2196F3" mode="Opaque" forecolor="#FFFFFF" uuid="c0000001-0001-0001-0001-000000000016"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Avg Value  ]]></text>
            </staticText>
            <staticText>
                <reportElement x="706" y="0" width="96" height="25" backcolor="#2196F3" mode="Opaque" forecolor="#FFFFFF" uuid="c0000001-0001-0001-0001-000000000017"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Revenue  ]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- DETAIL (each hotel row) -->
    <detail>
        <band height="20">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="160" height="20" uuid="c0000001-0001-0001-0001-000000000020"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["  " + $F{hotel_name}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="0" width="90" height="20" uuid="c0000001-0001-0001-0001-000000000021"/>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["  " + $F{hotel_city}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="80" height="20" uuid="c0000001-0001-0001-0001-000000000022"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{total_bookings}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="0" width="80" height="20" forecolor="#D32F2F" uuid="c0000001-0001-0001-0001-000000000023"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{cancelled_count}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="410" y="0" width="100" height="20" uuid="c0000001-0001-0001-0001-000000000024"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{total_nights}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="510" y="0" width="100" height="20" uuid="c0000001-0001-0001-0001-000000000025"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{total_rooms_booked}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="610" y="0" width="96" height="20" uuid="c0000001-0001-0001-0001-000000000026"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{avg_booking_value}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="706" y="0" width="96" height="20" uuid="c0000001-0001-0001-0001-000000000027"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{total_revenue}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="19" width="802" height="1" forecolor="#EEEEEE" uuid="c0000001-0001-0001-0001-000000000028"/>
            </line>
        </band>
    </detail>
    <!-- PAGE FOOTER -->
    <pageFooter>
        <band height="25">
            <staticText>
                <reportElement x="0" y="5" width="400" height="15" forecolor="#999999" uuid="c0000001-0001-0001-0001-000000000040"/>
                <textElement><font size="7"/></textElement>
                <text><![CDATA[Generated by Booking System | Data source: PostgreSQL Direct Query]]></text>
            </staticText>
            <textField>
                <reportElement x="650" y="5" width="100" height="15" forecolor="#999999" uuid="c0000001-0001-0001-0001-000000000041"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="750" y="5" width="52" height="15" forecolor="#999999" uuid="c0000001-0001-0001-0001-000000000042"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    <!-- SUMMARY (grand total) -->
    <summary>
        <band height="40">
            <line>
                <reportElement x="0" y="0" width="802" height="1" uuid="c0000001-0001-0001-0001-000000000030"/>
                <graphicElement><pen lineWidth="2.0"/></graphicElement>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="250" height="25" uuid="c0000001-0001-0001-0001-000000000031"/>
                <textElement verticalAlignment="Middle"><font size="12" isBold="true"/></textElement>
                <text><![CDATA[  GRAND TOTAL]]></text>
            </staticText>
            <textField>
                <reportElement x="250" y="5" width="80" height="25" uuid="c0000001-0001-0001-0001-000000000032"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{grandTotalBookings}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="706" y="5" width="96" height="25" forecolor="#D32F2F" uuid="c0000001-0001-0001-0001-000000000033"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{grandTotalRevenue}]]></textFieldExpression>
            </textField>
        </band>
    </summary>


</jasperReport>