<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="monthly-revenue"
              pageWidth="842" pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="d1000001-0001-0001-0001-000000000001">

    <parameter name="fromDate" class="java.sql.Date"/>
    <parameter name="toDate" class="java.sql.Date"/>
    <parameter name="ownerUserId" class="java.lang.String"/>
    <parameter name="hotelId" class="java.lang.String"/>
    <parameter name="reportTitle" class="java.lang.String">
        <defaultValueExpression><![CDATA["MONTHLY REVENUE REPORT"]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
            SELECT
                TO_CHAR(b.paid_at AT TIME ZONE 'Asia/Ho_Chi_Minh', 'YYYY-MM-DD') AS revenue_day,
                h.name AS hotel_name,
                h.city AS hotel_city,
                COUNT(b.id) AS paid_bookings,
                SUM(b.num_nights) AS total_nights,
                SUM(b.num_rooms) AS total_rooms_booked,
                SUM(COALESCE(b.total_price, 0) - COALESCE(b.refund_amount, 0)) AS gross_revenue,
                AVG(COALESCE(b.total_price, 0) - COALESCE(b.refund_amount, 0)) AS avg_booking_value
            FROM booking.bookings b
            JOIN booking.hotels h ON b.hotel_id = h.id
            WHERE b.paid_at >= CAST($P{fromDate} AS timestamp)
              AND CAST($P{toDate} AS timestamp) + INTERVAL '1 day' > b.paid_at
              AND b.payment_status IN ('PAID', 'PARTIALLY_REFUNDED', 'REFUNDED')
              AND b.status IN ('CONFIRMED', 'COMPLETED')
              AND ($P{ownerUserId} IS NULL OR h.owner_user_id = CAST($P{ownerUserId} AS uuid))
              AND ($P{hotelId} IS NULL OR h.id = CAST($P{hotelId} AS uuid))
            GROUP BY revenue_day, h.name, h.city
            ORDER BY revenue_day ASC, gross_revenue DESC
        ]]>
    </queryString>

    <field name="revenue_day" class="java.lang.String"/>
    <field name="hotel_name" class="java.lang.String"/>
    <field name="hotel_city" class="java.lang.String"/>
    <field name="paid_bookings" class="java.lang.Long"/>
    <field name="total_nights" class="java.lang.Long"/>
    <field name="total_rooms_booked" class="java.lang.Long"/>
    <field name="gross_revenue" class="java.math.BigDecimal"/>
    <field name="avg_booking_value" class="java.math.BigDecimal"/>

    <variable name="grandTotalRevenue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{gross_revenue}]]></variableExpression>
    </variable>
    <variable name="grandTotalBookings" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{paid_bookings}]]></variableExpression>
    </variable>

    <title>
        <band height="70">
            <textField>
                <reportElement x="0" y="0" width="802" height="30" uuid="d1000001-0001-0001-0001-000000000002"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="20" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="35" width="802" height="20" forecolor="#666666" uuid="d1000001-0001-0001-0001-000000000003"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Sans" size="11" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement>
                <textFieldExpression><![CDATA["Period: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{fromDate}) + " - " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($P{toDate})]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="60" width="802" height="1" forecolor="#16A34A" uuid="d1000001-0001-0001-0001-000000000004"/>
                <graphicElement><pen lineWidth="2.0"/></graphicElement>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText><reportElement x="0" y="0" width="80" height="25" backcolor="#16A34A" mode="Opaque" forecolor="#FFFFFF" uuid="d1000001-0001-0001-0001-000000000010"/><textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><text><![CDATA[  Date]]></text></staticText>
            <staticText><reportElement x="80" y="0" width="180" height="25" backcolor="#16A34A" mode="Opaque" forecolor="#FFFFFF" uuid="d1000001-0001-0001-0001-000000000011"/><textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><text><![CDATA[  Hotel]]></text></staticText>
            <staticText><reportElement x="260" y="0" width="90" height="25" backcolor="#16A34A" mode="Opaque" forecolor="#FFFFFF" uuid="d1000001-0001-0001-0001-000000000012"/><textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><text><![CDATA[  City]]></text></staticText>
            <staticText><reportElement x="350" y="0" width="80" height="25" backcolor="#16A34A" mode="Opaque" forecolor="#FFFFFF" uuid="d1000001-0001-0001-0001-000000000013"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><text><![CDATA[Bookings]]></text></staticText>
            <staticText><reportElement x="430" y="0" width="80" height="25" backcolor="#16A34A" mode="Opaque" forecolor="#FFFFFF" uuid="d1000001-0001-0001-0001-000000000014"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><text><![CDATA[Nights]]></text></staticText>
            <staticText><reportElement x="510" y="0" width="90" height="25" backcolor="#16A34A" mode="Opaque" forecolor="#FFFFFF" uuid="d1000001-0001-0001-0001-000000000015"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><text><![CDATA[Rooms]]></text></staticText>
            <staticText><reportElement x="600" y="0" width="100" height="25" backcolor="#16A34A" mode="Opaque" forecolor="#FFFFFF" uuid="d1000001-0001-0001-0001-000000000016"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><text><![CDATA[Avg Value  ]]></text></staticText>
            <staticText><reportElement x="700" y="0" width="102" height="25" backcolor="#16A34A" mode="Opaque" forecolor="#FFFFFF" uuid="d1000001-0001-0001-0001-000000000017"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><text><![CDATA[Revenue  ]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="80" height="20" uuid="d1000001-0001-0001-0001-000000000020"/><textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><textFieldExpression><![CDATA["  " + $F{revenue_day}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="80" y="0" width="180" height="20" uuid="d1000001-0001-0001-0001-000000000021"/><textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><textFieldExpression><![CDATA["  " + $F{hotel_name}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement x="260" y="0" width="90" height="20" uuid="d1000001-0001-0001-0001-000000000022"/><textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><textFieldExpression><![CDATA["  " + $F{hotel_city}]]></textFieldExpression></textField>
            <textField><reportElement x="350" y="0" width="80" height="20" uuid="d1000001-0001-0001-0001-000000000023"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><textFieldExpression><![CDATA[$F{paid_bookings}]]></textFieldExpression></textField>
            <textField><reportElement x="430" y="0" width="80" height="20" uuid="d1000001-0001-0001-0001-000000000024"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><textFieldExpression><![CDATA[$F{total_nights}]]></textFieldExpression></textField>
            <textField><reportElement x="510" y="0" width="90" height="20" uuid="d1000001-0001-0001-0001-000000000025"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><textFieldExpression><![CDATA[$F{total_rooms_booked}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="600" y="0" width="100" height="20" uuid="d1000001-0001-0001-0001-000000000026"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><textFieldExpression><![CDATA[$F{avg_booking_value}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="700" y="0" width="102" height="20" uuid="d1000001-0001-0001-0001-000000000027"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="8" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{gross_revenue}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="19" width="802" height="1" forecolor="#EEEEEE" uuid="d1000001-0001-0001-0001-000000000028"/></line>
        </band>
    </detail>
    <pageFooter>
        <band height="25">
            <staticText><reportElement x="0" y="5" width="400" height="15" forecolor="#999999" uuid="d1000001-0001-0001-0001-000000000040"/><textElement><font fontName="DejaVu Sans" size="7" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><text><![CDATA[Generated by Booking System | Monthly revenue report]]></text></staticText>
            <textField><reportElement x="650" y="5" width="100" height="15" forecolor="#999999" uuid="d1000001-0001-0001-0001-000000000041"/><textElement textAlignment="Right"><font fontName="DejaVu Sans" size="7" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " / "]]></textFieldExpression></textField>
            <textField evaluationTime="Report"><reportElement x="750" y="5" width="52" height="15" forecolor="#999999" uuid="d1000001-0001-0001-0001-000000000042"/><textElement><font fontName="DejaVu Sans" size="7" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H"/></textElement><textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
    <summary>
        <band height="40">
            <line><reportElement x="0" y="0" width="802" height="1" uuid="d1000001-0001-0001-0001-000000000030"/><graphicElement><pen lineWidth="2.0"/></graphicElement></line>
            <staticText><reportElement x="0" y="5" width="250" height="25" uuid="d1000001-0001-0001-0001-000000000031"/><textElement verticalAlignment="Middle"><font fontName="DejaVu Sans" size="12" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><text><![CDATA[  MONTH TOTAL]]></text></staticText>
            <textField><reportElement x="350" y="5" width="80" height="25" uuid="d1000001-0001-0001-0001-000000000032"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="10" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{grandTotalBookings}]]></textFieldExpression></textField>
            <textField pattern="#,##0.00"><reportElement x="700" y="5" width="102" height="25" forecolor="#16A34A" uuid="d1000001-0001-0001-0001-000000000033"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="12" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{grandTotalRevenue}]]></textFieldExpression></textField>
        </band>
    </summary>


</jasperReport>
